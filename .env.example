# Provider: openai | deepseek | openrouter
ANNA_PROVIDER=deepseek

# Optional model override. Defaults per provider:
#   openai     -> gpt-4o
#   deepseek   -> deepseek-flash
#   openrouter -> openai/gpt-4o
# ANNA_MODEL=

# API keys (only the one for your chosen provider is required)
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Optional: generic override (applies to any provider)
# ANNA_API_KEY=
# ANNA_BASE_URL=

# Max agent steps per instruction
ANNA_MAX_STEPS=25

# --- Voice (phase 3) ---
# Wake word to listen for
ANNA_WAKE_WORD=hey anna

# Speech-to-text engine: mlx (local, default) | openai (Whisper API)
ANNA_STT_ENGINE=mlx
# Local MLX Whisper model (any mlx-community/whisper-* repo)
ANNA_STT_MODEL=mlx-community/whisper-base.en-mlx

# Spoken feedback via macOS `say` (0 to disable)
ANNA_TTS=1

# --- Safety ---
# Log every action decision to ~/.anna/audit.jsonl (0 to disable)
ANNA_AUDIT=1
# Override the audit log location
# ANNA_AUDIT_LOG=~/.anna/audit.jsonl
